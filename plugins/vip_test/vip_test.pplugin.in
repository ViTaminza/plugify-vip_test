{
	"$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
	"version": "${VIP_TEST_VERSION}",
	"name": "vip_test",
	"description": "[VIP] VIP Test: !viptest / mm_viptest (and !testvip / mm_testvip) hands a free VIP period (vip_test.ini: group, time, timeout) to a player who does not have VIP yet, at most once per timeout seconds; a running cooldown prints when the next grant becomes available. Ported from the Pisex VIP core module VIP_Test (vip_test). Requires the vip core.",
	"author": "Pisex, ported to Plugify",
	"website": "https://github.com/untrustedmodders/plugify",
	"license": "GPL-3.0",
	"entry": "bin/vip_test",
	"platforms": [],
	"language": "cpp",
	"dependencies": [
		{
			"name": "s2sdk",
			"constraints": ">=2.18.2"
		},
		{
			"name": "vip",
			"constraints": ">=1.0.0"
		},
		{
			"name": "permissions",
			"constraints": ">=1.3.1",
			"optional": true
		}
	]
}
